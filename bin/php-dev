#!/bin/zsh -f

show_help() {
  cat <<'EOF'
Usage: php-dev <command> [arguments]
       phpd <command> [arguments]     (short alias)

  menu                          Open the interactive menu
  install                       Configure php-dev in Zsh

Stack commands
  status [--json]               Show stack, ports, DNS, PHP and Composer
  doctor [--fix]                Check apps, setup and stack; --fix repairs the stack
  herd | flock | toggle         Switch the web, DNS and MySQL stack
  mysql [status|dbngin|flock|toggle]
                                Inspect or switch MySQL independently
  logs [name] [-f] [-n lines]   List or show the active stack's service logs

Site commands
  sites                         List the sites in $DEVENV_SITES with their URLs
  open [site]                   Open a site (default: the current one) in the browser
  db [database]                 Open a MySQL shell (uses the project's .env)

Project commands
  php [args]                    Run PHP from the selected stack
  composer [args]               Run Composer with the selected stack on PATH
  artisan [args]                Run Artisan from a Laravel project directory
  serve | tinker | test [args]   Run the corresponding Artisan command
  dev [args]                    Run composer run dev

CLI settings
  icons [nerd|emoji]            Show or save php-dev's icon style (default: nerd)

Run php-dev with no arguments to open the menu in an interactive terminal.
EOF
}

usage_error() {
  print -ru2 -- "php-dev: $1. Run php-dev --help for usage."
  exit 2
}

if (( $# == 0 )); then
  if [[ -t 0 && -t 1 && ${TERM:-dumb} != dumb ]]; then
    set -- menu
  else
    set -- help
  fi
fi

repo_root=${0:A:h:h}
subcommand=$1
case $subcommand in
  help|-h|--help) show_help; exit 0 ;;
  menu|install|status|doctor|herd|flock|toggle|mysql|logs|icons|sites|open|db|php|composer|artisan|serve|tinker|test|dev) shift ;;
  *) usage_error "unknown command '$subcommand'" ;;
esac

source "$repo_root/shell/devenv.zsh" || exit 1

case $subcommand in
  menu)
    (( $# == 0 )) || usage_error "'menu' takes no arguments"
    [[ -t 0 && -t 1 && ${TERM:-dumb} != dumb ]] || usage_error 'menu needs an interactive terminal'
    exec "${PHP_DEV_RUNTIME_PHP:-php}" "$repo_root/src/menu.php"
    ;;
  install)
    (( $# == 0 )) || usage_error "'install' takes no arguments"
    exec "${PHP_DEV_RUNTIME_PHP:-php}" "$repo_root/src/install-zsh.php"
    ;;
  status)
    (( $# == 0 )) || [[ $# == 1 && $1 == --json ]] || usage_error "'status' takes only --json"
    devenv-status "$@"
    ;;
  doctor)
    (( $# == 0 )) || [[ $# == 1 && $1 == --fix ]] || usage_error "'doctor' takes only --fix"
    devenv-doctor "$@"
    ;;
  herd|flock|toggle|sites)
    (( $# == 0 )) || usage_error "'$subcommand' takes no arguments"
    [[ $subcommand == sites ]] && devenv-sites || devenv "$subcommand"
    ;;
  open|db)
    (( $# <= 1 )) || usage_error "'$subcommand' takes at most one argument"
    devenv-$subcommand "$@"
    ;;
  logs) devenv-logs "$@" ;;
  icons)
    (( $# <= 1 )) || usage_error "'icons' takes at most one argument"
    devenv-icons "$@"
    ;;
  mysql)
    (( $# <= 1 )) || usage_error 'mysql takes at most one argument'
    case ${1:-status} in
      status) mysql-status ;;
      dbngin|flock|toggle) switch-mysql "$1" ;;
      *) usage_error "unknown MySQL action '$1'" ;;
    esac
    ;;
  php|composer) exec "$subcommand" "$@" ;;
  dev) exec composer run dev "$@" ;;
  artisan|serve|tinker|test)
    if [[ ! -f ./artisan ]]; then
      print -ru2 -- 'php-dev: run this command from a Laravel project directory containing artisan.'
      exit 1
    fi
    [[ $subcommand == artisan ]] || set -- "$subcommand" "$@"
    exec php ./artisan "$@"
    ;;
esac
