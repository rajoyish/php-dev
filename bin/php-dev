#!/bin/zsh -f

show_help() {
  cat <<'EOF'
Usage: php-dev <command> [arguments]

Stack commands
  status                        Show stack, ports, DNS, PHP and Composer
  herd | flock | toggle         Switch the web, DNS and MySQL stack
  mysql [status|dbngin|flock|toggle]
                                Inspect or switch MySQL independently

Project commands
  php [args]                    Run PHP from the selected stack
  composer [args]               Run Composer with the selected stack on PATH
  artisan [args]                Run Artisan from a Laravel project directory
  serve | tinker | test [args]   Run the corresponding Artisan command
  dev [args]                    Run composer run dev

Run php-dev with no arguments to show this help.
EOF
}

usage_error() {
  print -ru2 -- "php-dev: $1. Run php-dev --help for usage."
  exit 2
}

subcommand=${1:-help}
case $subcommand in
  help|-h|--help) show_help; exit 0 ;;
  status|herd|flock|toggle|mysql|php|composer|artisan|serve|tinker|test|dev) shift ;;
  *) usage_error "unknown command '$subcommand'" ;;
esac

source "${0:A:h:h}/shell/devenv.zsh" || exit 1

case $subcommand in
  status|herd|flock|toggle)
    (( $# == 0 )) || usage_error "'$subcommand' takes no arguments"
    devenv "$subcommand"
    ;;
  mysql)
    (( $# <= 1 )) || usage_error 'mysql takes at most one argument'
    case ${1:-status} in
      status) mysql-status ;;
      dbngin|flock|toggle) switch-mysql "$1" ;;
      *) usage_error "unknown MySQL action '$1'" ;;
    esac
    ;;
  php|composer) exec "$subcommand" "$@" ;;
  dev) exec composer run dev "$@" ;;
  artisan|serve|tinker|test)
    if [[ ! -f ./artisan ]]; then
      print -ru2 -- 'php-dev: run this command from a Laravel project directory containing artisan.'
      exit 1
    fi
    [[ $subcommand == artisan ]] || set -- "$subcommand" "$@"
    exec php ./artisan "$@"
    ;;
esac
